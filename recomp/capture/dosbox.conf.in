# DOSBox-X config for state capture (tools/capture.py fills in @GAMEDIR@).
# No sound hardware: the game then skips AIL entirely, so no driver timing
# or sound IRQs disturb the captured states.
[sdl]
output=surface
[dosbox]
memsize=16
machine=svga_s3
[cpu]
core=normal
cputype=pentium
cycles=max
[mixer]
nosound=true
[sblaster]
sbtype=none
[speaker]
pcspeaker=false
[log]
logfile=dosbox.log
[autoexec]
mount c "@GAMEDIR@"
c:
war.exe
